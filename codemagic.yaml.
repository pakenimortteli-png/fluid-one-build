
workflows:
  fluid-one:
    name: Build Fluid One APK
    max_build_duration: 60
    instance_type: linux_x2

    environment:
      java: 17

    scripts:
      - name: Extract project
        script: unzip -o FluidOneAndroidProject.zip -d .

      - name: Build debug APK
        script: |
          cd FluidOneAndroid
          chmod +x gradlew
          ./gradlew --no-daemon assembleDebug

    artifacts:
      - FluidOneAndroid/app/build/outputs/apk/debug/*.apk
